# Copy to .env with scripts/init-env.sh (it fills in random values) or by hand.
# .env is git-ignored. Never commit real values.

# Public address of the site. https => the app redirects to SSL and sets secure cookies.
APP_URL=http://localhost:18090
# Port published by nginx on the host, and the address it binds to.
# 127.0.0.1 = only a reverse proxy on this machine can reach it; 0.0.0.0 = open (http demo).
WEB_PORT=18090
BIND_ADDR=127.0.0.1

# Secrets (the app refuses to start in production while these are CHANGE_ME or short)
SECRET_KEY_BASE=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# First user, created at start-up if it does not exist yet. No demo data is seeded.
ADMIN_EMAIL=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Optional: outgoing mail for password resets. Without SMTP_ADDRESS, mails are dropped.
MAIL_FROM=noreply@example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
